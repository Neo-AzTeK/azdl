{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "azdl",
  "version": "0.1.0",
  "identifier": "io.azdl.launcher",
  "build": {
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "azdl",
        "label": "main",
        "width": 1200,
        "height": 800,
        "minWidth": 920,
        "minHeight": 620,
        "zoomHotkeysEnabled": false,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Modern game launcher and runtime orchestrator",
    "longDescription": "Modern plug-and-play game launcher and runtime orchestrator with automated catalog aggregation, prefix isolation, DRM stripping, and patch management.",
    "category": "Game"
  }
}
